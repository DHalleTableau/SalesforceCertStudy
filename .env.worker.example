# Copy to .env.worker and fill in real values, then run ./run_worker.sh
# instead of retyping the long env-var command every time. Gitignored --
# never commit a filled-in .env.worker (this repo is public).

# Deployed Heroku Postgres URL -- get it fresh anytime with:
#   heroku config:get DATABASE_URL -a sf-cert-study
DATABASE_URL=

# Same internal-gateway credentials used everywhere else in this project
# (see .env.example for where these come from).
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
SALESFORCE_CA_BUNDLE=./salesforce-ca-bundle.pem
