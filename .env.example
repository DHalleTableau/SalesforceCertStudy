# Copy to .env for local development. Real values live only in Heroku
# config vars (this repo is public) — never commit a filled-in .env.

# Anthropic API access used by worker.py to generate questions/feedback.
# Internal-only Claude access is a hard requirement for this org -- see
# PLAN.md's Locked-in decisions. Use EITHER the plain key below, OR the
# three internal-gateway vars, not both:
ANTHROPIC_API_KEY=

# Internal gateway (org-required): bearer token + gateway URL, matching
# the ANTHROPIC_AUTH_TOKEN naming from the org's Claude Code setup docs.
# The gateway itself speaks the OpenAI Chat Completions API format, not
# Anthropic's native format -- see PLAN.md's Locked-in decisions.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
# PEM file of the org's internal CAs, so TLS trusts the gateway's cert.
# Export on a corporate-managed Mac via:
#   security find-certificate -a -p /Library/Keychains/System.keychain > salesforce-ca-bundle.pem
SALESFORCE_CA_BUNDLE=./salesforce-ca-bundle.pem

# Postgres connection string. Heroku sets this automatically when the
# Postgres add-on is provisioned. Falls back to a local sqlite file if
# unset, for a quick local boot check only.
DATABASE_URL=postgresql://localhost/salesforce_cert_study

# Flask session signing key.
FLASK_SECRET_KEY=

# Simple internal-only login (added in Phase 4).
APP_LOGIN_USERNAME=
APP_LOGIN_PASSWORD=
